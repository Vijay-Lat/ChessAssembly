{
  "targets": {
    "release": {
      "outFile": "public/release.wasm",
      "textFile": "public/release.wat",
      "optimizeLevel": 3,
      "shrinkLevel": 0,
      "converge": false,
      "noAssert": false,
      "exportRuntime": true 
    },
    "debug": {
      "outFile": "public/debug.wasm",
      "textFile": "public/debug.wat",
      "sourceMap": true,
      "debug": true,
      "exportRuntime": true
    }
  },
  "options": {
    "bindings": "esm",  
  "initialMemory": 100,
    "maximumMemory": 31250,
    "runtime": "incremental"
  }
}